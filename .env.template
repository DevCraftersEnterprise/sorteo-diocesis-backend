NODE_ENV=development
PORT=3000

# Misma base de datos que sorteo_backend (Express) durante la coexistencia
DATABASE_URL=postgres://usuario:password@host:puerto/dbname
# true (default) para Postgres administrados; false para Postgres local/Docker
DATABASE_SSL=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes del frontend permitidos por CORS, separados por coma.
# Default: http://localhost:5173 (vite dev). En producción, el dominio de Netlify.
CORS_ORIGINS=http://localhost:5173

# Deben coincidir con los del backend Express (datos ya cifrados/hasheados)
ENCRYPTION_KEY=
PHONE_SALT=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Zona horaria de las fechas del Excel exportado (default America/Hermosillo)
# TZ=America/Hermosillo
